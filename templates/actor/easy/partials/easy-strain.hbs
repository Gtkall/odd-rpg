{{!-- ODDEasy strain: 7 slots of Fatigue, Exhaustion or armor Bulk --}}
<div class="strain-panel">
  <div class="strain-header">
    <h3 class="panel-header">{{localize "ODD.Sections.strain"}}</h3>
    {{> "systems/odd-rpg/templates/actor/partials/roll-entry.hbs" shockRoll inline=true}}
    {{#if strainPenalty}}
      <span class="easy-strain-penalty rollable" data-pool-die="-{{strainPenalty}}"
            data-pool-label="{{localize "ODD.Easy.strainPenalty"}}"
            title="{{localize "ODD.Easy.addPenaltyHint"}}">
        {{localize "ODD.Easy.strainPenalty"}}: {{strainPenalty}}
      </span>
    {{/if}}
    {{#if isStrainFull}}
      <span class="easy-strain-full">{{localize "ODD.Easy.strainFull"}}</span>
    {{/if}}
  </div>

  <div class="strain-row">
    {{#each strainSlots}}
    <div class="strain-slot">
      <select name="system.strain.slots.{{index}}" class="slot-select">
        {{selectOptions ../strainValues selected=value localize=true}}
      </select>
      <div class="slot-label">{{label}}</div>
    </div>
    {{/each}}
  </div>

  {{!-- Penalty row: mirrors the slot flex layout so dice align with their columns --}}
  <div class="strain-penalty-row">
    <span class="strain-penalty-label">{{localize "ODD.Easy.strainPenalty"}}</span>
    {{#each strainSlots}}
    <div class="penalty-cell">{{#if fatiguePenalty}}{{fatiguePenalty}}{{/if}}</div>
    {{/each}}
  </div>
</div>
