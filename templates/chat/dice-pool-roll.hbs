{{!-- Dice Pool Roll Chat Message --}}
<div class="odd-roll-result">
  {{#if isKeepHighest}}<div class="roll-label">Initiative Index</div>{{/if}}

  <div class="roll-dice-row">
    {{#each breakdown}}
      {{#unless ../isKeepHighest}}
        {{#if this.penalty}}<span class="roll-operator">−</span>
        {{else unless @first}}<span class="roll-operator">+</span>{{/if}}
      {{/unless}}
      <div class="roll-die-entry{{#if this.discarded}} discarded{{/if}}{{#if this.hitch}} hitch{{/if}}{{#if this.fate}} fate{{/if}}{{#if this.pushedFrom}} pushed{{/if}}" data-index="{{@index}}">
        <div class="die-chip">{{this.result}}</div>
        <div class="die-meta">
          <span class="die-type">{{this.die}}</span>
          <span class="die-source">{{this.label}}</span>
        </div>
      </div>
    {{/each}}
  </div>

  <div class="roll-divider"></div>
  <div class="roll-total">{{total}}</div>
  {{#if snakeEyes}}
    <div class="roll-hitches snake-eyes">{{localize "ODD.Roll.snakeEyes"}}</div>
  {{else if hitches}}
    <div class="roll-hitches">{{#if (eq hitches 1)}}{{localize "ODD.Roll.hitch"}}{{else}}{{localize "ODD.Roll.hitches" count=hitches}}{{/if}}</div>
  {{/if}}
  {{#if push}}
    <div class="roll-push">
      {{#if push.exhaustion}}{{localize "ODD.Roll.pushedExhaustion" die=push.die from=push.from to=push.to}}
      {{else}}{{localize "ODD.Roll.pushedFatigue" die=push.die from=push.from to=push.to}}{{/if}}
    </div>
  {{/if}}
</div>
